---
layout: default
---
{% assign current_lang = page.lang | default: site.lang %}
{% assign locale = site.data.i18n[current_lang] %}
<div class="post">
  <header class="post-header academic-profile-header">
    <div class="academic-profile-header__identity">
      <p class="academic-profile-header__eyebrow">
        {% if current_lang == 'en' %}ACADEMIC PROFILE{% else %}AKADEMİK PROFİL{% endif %}
      </p>
      <h1 class="post-title">{{ page.display_name }}</h1>
      <p class="desc">{{ page.subtitle }}</p>
    </div>
    {% if page.profile and page.profile.image %}
      {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
      <div class="academic-profile-header__portrait">
        {%
          include figure.liquid
          loading="eager"
          path=profile_image_path
          class="academic-profile-header__image"
          sizes="(min-width: 720px) 160px, 112px"
          alt=page.profile.image_alt
          cache_bust=true
        %}
      </div>
    {% endif %}
  </header>

  <article>
    <div class="clearfix">{{ content }}</div>

    {% if page.announcements and page.announcements.enabled %}
      <h2><a href="{{ page.news_url | default: '/news/' | relative_url }}" style="color: inherit">{{ locale.news }}</a></h2>
      {% include news.liquid limit=true %}
    {% endif %}

    {% if page.latest_posts and page.latest_posts.enabled %}
      <h2><a href="{{ page.blog_url | default: '/blog/' | relative_url }}" style="color: inherit">{{ locale.latest_posts }}</a></h2>
      {% include latest_posts.liquid %}
    {% endif %}

    {% if page.selected_papers %}
      <h2>
        <a href="{{ page.publications_url | default: '/publications/' | relative_url }}" style="color: inherit">{{ locale.selected_publications }}</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% social_links %}</div>
        <div class="contact-note">{{ page.contact_note | default: locale.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% if site.plugins contains 'al_newsletter' %}
        {% include plugins/al_newsletter_form_center_margin.liquid %}
      {% else %}
        {% include newsletter.liquid center=true %}
      {% endif %}
    {% endif %}
  </article>
</div>
