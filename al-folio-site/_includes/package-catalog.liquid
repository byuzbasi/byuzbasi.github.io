{% assign catalog_lang = page.lang | default: 'tr' %}
{% assign published_packages = site.data.research_packages | where_exp: 'package', 'package.docs.published == true' %}
{% assign upcoming_packages = site.data.research_packages | where_exp: 'package', 'package.docs.published != true' %}
{% assign catalog_packages = published_packages | concat: upcoming_packages %}
<div class="package-catalog">
  {% for package in catalog_packages %}
    <article id="{{ package.id | escape }}" class="package-card" aria-labelledby="package-{{ package.id | escape }}">
      <h3 id="package-{{ package.id | escape }}">
        {% if package.docs.published and package.verified_links.docs %}
          <a href="{{ package.docs.path | absolute_url }}">{{ package.name | escape }} <span aria-hidden="true">↗</span></a>
        {% elsif package.source_url and package.verified_links.source_url %}
          <a href="{{ package.source_url | escape }}">{{ package.name | escape }} <span aria-hidden="true">↗</span></a>
        {% else %}
          {{ package.name | escape }}
        {% endif %}
      </h3>
      <p class="package-card__subtitle">{{ package.subtitle | escape }}</p>
      <p>{{ package.description[catalog_lang] | escape }}</p>
      <p class="package-card__meta">{{ package.technologies | escape }}</p>
      <div class="package-card__links">
        {% if package.docs.published and package.verified_links.docs %}
          <a class="package-card__link package-card__link--primary" href="{{ package.docs.path | absolute_url }}">
            {% if catalog_lang == 'en' %}Package website{% else %}Paket sitesi{% endif %} <span aria-hidden="true">↗</span>
          </a>
          {% if package.docs.guide_path and package.verified_links.guide %}
            <a class="package-card__link" href="{{ package.docs.guide_path | absolute_url }}">
              {% if catalog_lang == 'en' %}Get started{% else %}Başlangıç rehberi{% endif %}
            </a>
          {% endif %}
        {% endif %}
        {% if package.source_url and package.verified_links.source_url %}
          <a class="package-card__link" href="{{ package.source_url | escape }}">
            {% if catalog_lang == 'en' %}GitHub repository{% else %}GitHub deposu{% endif %}
          </a>
        {% endif %}
        {% if package.reference_url and package.verified_links.reference_url %}
          <a class="package-card__link" href="{{ package.reference_url | escape }}">
            {% if catalog_lang == 'en' %}CRAN reference manual{% else %}CRAN başvuru kılavuzu{% endif %}
          </a>
        {% endif %}
      </div>
      {% unless package.docs.published %}
        <p class="package-card__status">{{ package.docs.status[catalog_lang] | escape }}.</p>
      {% endunless %}
      {% if package.article and package.verified_links.article_url %}
        <p class="package-card__article">
          {% if catalog_lang == 'en' %}Related article:{% else %}İlgili makale:{% endif %}
          <a href="{{ package.article.url | escape }}">{{ package.article.title | escape }}</a>
        </p>
      {% endif %}
      {% if package.citation %}
        <details class="catalog-citation"><summary>{% if catalog_lang == 'en' %}Cite this package{% else %}Bu pakete atıf{% endif %}</summary><p>{{ package.citation | escape }}</p></details>
      {% endif %}
      {% include catalog-project-links.liquid item=package %}
    </article>
  {% endfor %}
</div>
