{% capture author_name %}{{ site.first_name }}{% if site.middle_name %} {{ site.middle_name }}{% endif %} {{ site.last_name }}{% endcapture %}
{% assign current_lang = page.lang | default: site.lang %}
{% assign site_description = site.description %}
{% assign site_keywords = site.keywords %}
{% assign og_locale = 'tr_TR' %}
{% assign og_locale_alternate = 'en_US' %}
{% if current_lang == 'en' %}
  {% assign site_description = site.description_en | default: site.description %}
  {% assign site_keywords = site.keywords_en | default: site.keywords %}
  {% assign og_locale = 'en_US' %}
  {% assign og_locale_alternate = 'tr_TR' %}
{% endif %}
{% assign meta_description = page.description | default: site_description %}
{% assign meta_keywords = page.keywords | default: site_keywords %}
{% assign page_absolute_url = page.url | replace: 'index.html', '' | absolute_url %}
{% assign preview_image = page.og_image | default: site.og_image %}

{% capture document_title %}
  {% if page.url == '/' or page.url == '/en/' or page.title == 'blank' %}
    {{ author_name }}
  {% elsif page.title %}
    {{ page.title }} | {{ author_name }}
  {% else %}
    {{ author_name }}
  {% endif %}
{% endcapture %}
{% assign document_title = document_title | strip %}

{% if site.enable_google_verification and site.google_site_verification %}
  <meta name="google-site-verification" content="{{ site.google_site_verification }}">
{% endif %}
{% if site.enable_bing_verification and site.bing_site_verification %}
  <meta name="msvalidate.01" content="{{ site.bing_site_verification }}">
{% endif %}

<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<title>{{ document_title }}</title>
<meta name="author" content="{{ author_name | strip | escape }}">
<meta name="description" content="{{ meta_description | strip_html | strip_newlines | escape }}">
{% if meta_keywords %}
  <meta name="keywords" content="{{ meta_keywords | escape }}">
{% endif %}

{% if site.serve_og_meta %}
  <meta property="og:site_name" content="{{ author_name | strip | escape }}">
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ document_title | escape }}">
  <meta property="og:url" content="{{ page_absolute_url }}">
  <meta property="og:description" content="{{ meta_description | strip_html | strip_newlines | escape }}">
  <meta property="og:locale" content="{{ og_locale }}">
  <meta property="og:locale:alternate" content="{{ og_locale_alternate }}">
  {% if preview_image %}
    <meta property="og:image" content="{{ preview_image | absolute_url }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:type" content="image/png">
    <meta property="og:image:alt" content="{{ author_name | strip | escape }} — {{ site.data.schema_person.job_title | escape }}">
  {% endif %}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ document_title | escape }}">
  <meta name="twitter:description" content="{{ meta_description | strip_html | strip_newlines | escape }}">
  {% if preview_image %}
    <meta name="twitter:image" content="{{ preview_image | absolute_url }}">
    <meta name="twitter:image:alt" content="{{ author_name | strip | escape }} — {{ site.data.schema_person.job_title | escape }}">
  {% endif %}
{% endif %}

{% if site.serve_schema_org %}
  {% assign person = site.data.schema_person %}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": {{ site.url | append: '/#website' | jsonify }},
          "url": {{ site.url | append: '/' | jsonify }},
          "name": {{ author_name | strip | jsonify }},
          "description": {{ site.description_en | default: site.description | strip | jsonify }},
          "inLanguage": ["tr", "en"],
          "publisher": { "@id": {{ site.url | append: '/#person' | jsonify }} }
        },
        {
          "@type": "WebPage",
          "@id": {{ page_absolute_url | append: '#webpage' | jsonify }},
          "url": {{ page_absolute_url | jsonify }},
          "name": {{ document_title | jsonify }},
          "description": {{ meta_description | strip_html | strip_newlines | strip | jsonify }},
          "inLanguage": {{ current_lang | jsonify }},
          "isPartOf": { "@id": {{ site.url | append: '/#website' | jsonify }} },
          "about": { "@id": {{ site.url | append: '/#person' | jsonify }} }
        },
        {
          "@type": "Person",
          "@id": {{ site.url | append: '/#person' | jsonify }},
          "name": {{ person.name | jsonify }},
          "honorificPrefix": {{ person.honorific_prefix | jsonify }},
          "honorificSuffix": {{ person.honorific_suffix | jsonify }},
          "url": {{ site.url | append: '/' | jsonify }},
          "image": {{ person.image | jsonify }},
          "jobTitle": {{ person.job_title | jsonify }},
          "worksFor": {
            "@type": "CollegeOrUniversity",
            "name": {{ person.works_for.name | jsonify }},
            "url": {{ person.works_for.url | jsonify }}
          },
          "memberOf": {
            "@type": "Organization",
            "name": {{ person.member_of.name | jsonify }},
            "url": {{ person.member_of.url | jsonify }}
          },
          "sameAs": {{ person.same_as | jsonify }},
          "knowsAbout": {{ person.knows_about | jsonify }}
        }
      ]
    }
  </script>
{% endif %}
