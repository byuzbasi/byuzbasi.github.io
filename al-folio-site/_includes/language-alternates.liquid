{% assign current_lang = page.lang | default: site.lang %}
{% assign translated_content = site.pages | concat: site.teachings %}
{% if page.translation_key %}
  {% assign default_translation = nil %}
  {% for translation in translated_content %}
    {% if translation.translation_key == page.translation_key and translation.lang %}
      <link rel="alternate" hreflang="{{ translation.lang }}" href="{{ translation.url | absolute_url }}">
      {% if translation.lang == site.lang %}
        {% assign default_translation = translation %}
      {% endif %}
    {% endif %}
  {% endfor %}
  {% if default_translation %}
    <link rel="alternate" hreflang="x-default" href="{{ default_translation.url | absolute_url }}">
  {% endif %}
{% endif %}
