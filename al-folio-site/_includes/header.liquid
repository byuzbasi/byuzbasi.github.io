{% assign current_lang = page.lang | default: site.lang %}
{% assign locale = site.data.i18n[current_lang] %}
{% assign translated_content = site.pages | concat: site.teachings %}
{% assign home_url = '/' %}
{% if current_lang == 'en' %}
  {% assign home_url = '/en/' %}
{% endif %}
{% assign about_title = '' %}
{% for candidate in site.pages %}
  {% if candidate.translation_key == 'about' and candidate.lang == current_lang %}
    {% assign about_title = candidate.nav_title | default: candidate.title %}
  {% endif %}
{% endfor %}
{% assign target_lang = 'en' %}
{% if current_lang == 'en' %}
  {% assign target_lang = 'tr' %}
{% endif %}
{% assign alternate_url = nil %}
{% for candidate in translated_content %}
  {% if page.translation_key and candidate.translation_key == page.translation_key and candidate.lang == target_lang %}
    {% assign alternate_url = candidate.url %}
  {% endif %}
{% endfor %}
{% unless alternate_url %}
  {% if target_lang == 'en' %}
    {% assign alternate_url = '/en/' %}
  {% else %}
    {% assign alternate_url = '/' %}
  {% endif %}
{% endunless %}

<header>
  <nav id="navbar" class="navbar navbar-light portal-navbar-shell {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" role="navigation">
    <div class="container portal-navbar">
      <a class="navbar-brand title font-weight-lighter" href="{{ home_url | relative_url }}">
        <span class="font-weight-bold">{{ locale.brand_bold }}</span>
        {{ locale.brand_light }}
      </a>

      <button
        class="navbar-toggler collapsed navbar-toggler-main"
        type="button"
        data-nav-toggle="navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="{{ locale.nav_toggle }}"
      >
        <span class="sr-only">{{ locale.nav_toggle }}</span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <div class="navbar-collapse navbar-collapse-main" id="navbarNav">
        <ul class="navbar-nav navbar-menu-list portal-primary-nav flex-nowrap">
          {% for item in site.data.navigation %}
            {% assign nav_page = site.pages | where: 'translation_key', item.key | where: 'lang', current_lang | first %}
            {% if nav_page %}
              <li class="nav-item {% if page.translation_key == item.key %}active{% endif %}">
                <a class="nav-link" href="{{ nav_page.url | relative_url }}" {% if page.translation_key == item.key %}aria-current="page"{% endif %}>
                  {{ item.label[current_lang] | default: nav_page.nav_title | default: nav_page.title | escape }}
                </a>
              </li>
            {% endif %}
          {% endfor %}

        </ul>
        <div class="portal-navbar__utilities">
          <div class="language-switcher">
            <div class="language-switcher__inner" aria-label="{{ locale.language_label }}">
              {% if current_lang == 'tr' %}
                <span class="language-switcher__current" lang="tr" aria-current="true">TR</span>
                <span class="language-switcher__separator" aria-hidden="true">·</span>
                <a href="{{ alternate_url | relative_url }}" hreflang="en" lang="en">EN</a>
              {% else %}
                <a href="{{ alternate_url | relative_url }}" hreflang="tr" lang="tr">TR</a>
                <span class="language-switcher__separator" aria-hidden="true">·</span>
                <span class="language-switcher__current" lang="en" aria-current="true">EN</span>
              {% endif %}
            </div>
          </div>

          {% if site.search_enabled %}
            <button id="search-toggle" type="button" title="{{ locale.search_title }}" aria-label="{{ locale.search_label }}">
              <span class="portal-utility-button"><span class="portal-search-shortcut">⌘ k</span> <i class="fa-solid fa-magnifying-glass"></i></span>
            </button>
          {% endif %}
          {% if site.enable_darkmode %}
            <button id="light-toggle" type="button" title="{{ locale.theme_title }}" aria-label="{{ locale.theme_label }}">
              <i class="fa-half-sun-moon" id="light-toggle-system"></i>
              <i class="fa-solid fa-moon" id="light-toggle-dark"></i>
              <i class="fa-solid fa-sun" id="light-toggle-light"></i>
            </button>
          {% endif %}
        </div>
      </div>
    </div>
  </nav>
  {% if site.enable_progressbar %}
    <progress id="progress" value="0">
      <div class="progress-container">
        <span class="progress-bar"></span>
      </div>
    </progress>
  {% endif %}
</header>
